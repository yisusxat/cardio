{
  "name": "cardiocenter",
  "version": "1.0.0",
  "description": "Sistema de gestión de citas médicas para cardiología",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "lint": "npm run lint -w backend && npm run lint -w frontend",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7"
  },
  "lint-staged": {
    "backend/**/*.{ts,tsx}": "npm run lint -w backend --",
    "frontend/**/*.{ts,tsx}": "npm run lint -w frontend --"
  },
  "packageManager": "pnpm@9.1.0",
  "dependencies": {
    "@prisma/client": "^7.9.1",
    "prisma": "^7.9.1"
  },
  "overrides": {
    "vite": "^6.4.3",
    "react-router": "6.28.2",
    "react-router-dom": "6.28.2",
    "@remix-run/router": "1.23.2",
    "esbuild": "^0.25.0",
    "launch-editor": "^3.1.2",
    "brace-expansion": "2.1.2"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.4.3",
      "react-router": "6.28.2",
      "react-router-dom": "6.28.2",
      "@remix-run/router": "1.23.2",
      "esbuild": "^0.25.0",
      "launch-editor": "^3.1.2",
      "brace-expansion": "2.1.2"
    }
  }
}
