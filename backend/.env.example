# Server
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL="postgresql://cardiology_user:cardiology_password@localhost:5432/cardiology_db?schema=public"

# Security
JWT_SECRET="min-32-chars-super-secret-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=12

# CORS
CORS_ORIGIN="http://localhost:5173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
