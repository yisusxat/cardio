generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      UserRole @default(PATIENT)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientAppointments Appointment[] @relation("PatientAppointments")
  doctorProfile       Doctor?
  patientProfile      PatientProfile?
  clinicalNotes       ClinicalNote[] @relation("PatientClinicalNotes")

  @@map("users")
}

model PatientProfile {
  id                    String              @id @default(uuid())
  userId                String              @unique
  phone                 String?
  dateOfBirth           DateTime?           @db.Date
  gender                Gender?
  bloodType             BloodType?
  weightKg              Float?
  heightCm              Float?
  allergies             String?
  chronicConditions     String?
  currentMedications    String?
  smoker                Boolean?
  alcoholConsumption    AlcoholConsumption?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("patient_profiles")
}

model Doctor {
  id        String  @id @default(uuid())
  userId    String  @unique
  specialty String
  bio       String?
  basePrice Decimal @db.Decimal(10, 2)
  isActive  Boolean @default(true)

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  schedules    Schedule[]
  services     Service[]
  appointments Appointment[]
  clinicalNotes ClinicalNote[]

  @@map("doctors")
}

model Schedule {
  id        String @id @default(uuid())
  doctorId  String
  dayOfWeek Int
  startTime String
  endTime   String

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@unique([doctorId, dayOfWeek, startTime])
  @@map("schedules")
}

model Service {
  id          String  @id @default(uuid())
  doctorId    String
  name        String
  description String?
  price       Decimal @db.Decimal(10, 2)
  isActive    Boolean @default(true)

  doctor              Doctor              @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  appointmentServices AppointmentService[]

  @@map("services")
}

model Appointment {
  id          String            @id @default(uuid())
  patientId   String
  doctorId    String
  date        DateTime          @db.Date
  startTime   String
  endTime     String
  reason      String?
  status      AppointmentStatus @default(PENDING)
  totalAmount Decimal           @db.Decimal(10, 2)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  patient  User               @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Restrict)
  doctor   Doctor             @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  services AppointmentService[]
  payments Payment[]
  clinicalNote ClinicalNote?

  @@map("appointments")
}

model AppointmentService {
  id            String @id @default(uuid())
  appointmentId String
  serviceId     String
  priceAtTime   Decimal @db.Decimal(10, 2)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@map("appointment_services")
}

model Payment {
  id            String        @id @default(uuid())
  appointmentId String
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod @default(CASH)
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@map("payments")
}

model AuditLog {
  id        String   @id @default(uuid())
  tableName String
  recordId  String
  action    String
  oldData   Json?
  newData   Json?
  userId    String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum AlcoholConsumption {
  NONE
  OCCASIONAL
  MODERATE
  HEAVY
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  INSURANCE
}

model ClinicalNote {
  id            String   @id @default(uuid())
  appointmentId String   @unique
  patientId     String
  doctorId      String
  bpRead        String?
  heartRate     String?
  diagnosis     String
  treatment     String
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient     User        @relation("PatientClinicalNotes", fields: [patientId], references: [id], onDelete: Restrict)
  doctor      Doctor      @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@map("clinical_notes")
}

